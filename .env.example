# Copy to .env and fill in your values.

MONGO_URI=mongodb://localhost:27017/criptoBalance
MONGO_DB_NAME=criptoBalance

# Sign-in tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Frontends allowed to call the API, comma separated
ALLOWED_ORIGINS=http://localhost:5173

# Optional: portfolio assistant (Claude). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
# CHAT_EFFORT=medium
# CHAT_DAILY_LIMIT=40
# CHAT_DEMO_DAILY_LIMIT=100

# EUR per USDT if Binance can't give the live rate
# FIAT_RATE=0.92

# Optional: email alerts, sent to the account's email (for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
